---
title: '.eco Whois Lookup'
description: 'Check who has registered a .eco domain'
page-path: whois/
og-image: opengraph/tiger-og.jpg
og-width: 1200
og-height: 630
active: whois
noindex: true
exclude: true
---

<section class="section whois bg-purple">
 <div class="container">
   <h1 class="search-header">.eco whois</h1>

   <form method="get" class="search-form" role="search">
     <h2 class="subheader"><label for="input-search">Check who has registered a .eco domain name.</label></h2>

     <div class="row">
       <div class="col-md-2"></div>
       <div class="col-md-8">
        <div class="input-group">
          <input id="input-search" type="search" class="form-control domain-search" name="domain" placeholder="example.eco" autocomplete="off" autocapitalize="off" title="{{t "global:search.head"}}">
          <button class="btn btn-search" title="{{t 'global:search.cta'}}">
            <svg xmlns="http://www.w3.org/2000/svg" class="bi bi-search" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
          </button>
        </div>
       </div>
       <div class="col-md-2"></div>
     </div>
   </form>
 </div>
</section>

<section class="section">
  <div class="container whois-results" hidden>
  </div>
</section>

<script>
function whois () {
  const domainInput = document.querySelector('.domain-search')
  const resultsDiv = document.querySelector('.whois-results')
  let domain = domainInput.value
  if (!domain) {
    resultsDiv.removeAttribute('hidden')
    resultsDiv.innerHTML = '<h3>Please enter a .eco domain name to look up.</h3>'
    return
  }

  domain = domain.replace(/[\s;<>"'\/=()]/g, '').replace(/\..*$/, '')
  domain += '.eco'
  domainInput.value = domain

  if (window.history) {
    const url = new URL(window.location)
    url.searchParams.set('domain', domain)
    window.history.pushState({}, '', url)
  }

  const url = new URL('{{ searchUrl }}/rdap')
  url.searchParams.set('domain', domain)
  window.fetch(url).then(response => {
    resultsDiv.removeAttribute('hidden')
    if (response.ok) {
      return response.json().then(function (results) {
        resultsDiv.innerHTML = generateWhoisOutput(results)
      })
    }
    if (response.status === 404) {
      resultsDiv.innerHTML = `${domain} has not been registered. Try <a href="/search?domain=${domain}">searching to see if it's available</a>.`
    }
  }).catch(handleSearchError)
  trackEvent('whois')
}

function formatDate (dateString) {
  const date = new Date(dateString)
  return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`
}

function badgeList (list) {
  return list.map(l => `<span class="badge text-bg-secondary">${l}</span>`).join(' ')
}

function generateWhoisOutput (results) {
  console.log(results)
  const lastUpdatedOutput = results.lastChanged ? `<dt>Last updated</dt><dd>${formatDate(results.lastChanged)}</dd>` : ''
  const onServerhold = results.status.find(s => s === 'server hold')
  const profileLink = onServerhold ? '' : ` (<a href="https://profiles.eco/${results.domain}">.eco profile</a>)`
  const domainOutput = `<div>
    <h3>Domain</h3>
    <dl>
      <dt>Name</dt><dd>${results.domain}${profileLink}</dd>
      <dt>Registrar</dt><dd><a href="${results.registrar.url}">${ results.registrar.name }</a></dd>
      <dt>Registered</dt><dd>${formatDate(results.registered)}</dd>
      <dt>Expires</dt><dd>${formatDate(results.expiration)}</dd>
      ${lastUpdatedOutput}
      <dt>Status</dt><dd>${badgeList(results.status)}</dd>
      <dt>Nameservers</dt><dd>${badgeList(results.nameservers)}</dd>
      <dt>DNSSEC</dt><dd>${results.dnssec ? 'Enabled' : 'Not enabled'}</dd>
    </dl>
  </div>`
  const registrantOutput = `<div>
    <h3>Registered by</h3>
    <dl>
      <dt>Organization</dt><dd>${results.registrant.org}</dd>
      <dt>Country</dt><dd>${results.registrant.address.country}</dd>
    </dl>
  </div>`
  return domainOutput + registrantOutput
}

function handleSearchError (ex) {
  console.error('Failed to load whois data: ' + ex)
  console.error(ex)
  window.Sentry && window.Sentry.captureException(ex, {
    extra: {
      ctx: 'Failed to fetch whois data'
    }
  })
  document.querySelector('.whois-results').innerHTML = '<h3>Unable to look up domain details. Please try again.</h3>'
}

document.querySelector('.search-form').addEventListener('submit', function (e) {
  e.preventDefault()
  whois()
})

document.addEventListener('DOMContentLoaded', function () {
  if ('URLSearchParams' in window) {
    const urlParams = new URLSearchParams(window.location.search)
    if (urlParams.has('domain')) {
      const domain = urlParams.get('domain')
      const domainInput = document.querySelector('.domain-search')
      domainInput.value = domain
      whois()
    }
  }
})
</script>
